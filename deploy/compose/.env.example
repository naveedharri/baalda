# Baalda self-host — copy to .env and fill in. Only the first three matter.
#
#   cp .env.example .env && docker compose up -d
#
# Compose refuses to start if any of the three required values is missing, rather
# than booting a server with a guessable secret.

# --- Required ---------------------------------------------------------------

# Postgres password. Any long random string; it never leaves the Compose network.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs Better Auth sessions AND the per-doc sync JWTs. If this leaks, anyone can
# mint a token for any note, so treat it like a database password. The server
# REFUSES to boot in production if it is unset.
#   openssl rand -base64 32
JWT_SECRET=

# The public HTTPS URL clients reach this server on — what you type into the
# desktop app's Server settings, and what Better Auth builds invitation and
# email-verification links from. Get this wrong and invites point somewhere dead.
# No trailing slash.
BETTER_AUTH_URL=https://baalda.example.com

# --- Optional ---------------------------------------------------------------

# Host port and bind address for the HTTP listener. The default binds to
# localhost only, on the assumption a TLS proxy sits in front (see README).
# Set BIND_ADDR=0.0.0.0 ONLY if something else is terminating TLS for you.
# PORT=3010
# BIND_ADDR=127.0.0.1

# Google sign-in. Leave unset and the desktop app hides the Google button;
# email + password keeps working. Create a "Web application" OAuth client at
# console.cloud.google.com → APIs & Services → Credentials, with this authorized
# redirect URI:
#   https://<your-server>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Per-doc sync JWT lifetime, seconds. Default 600.
# SYNC_TOKEN_TTL_SECONDS=600

# Merge a note's update log into a snapshot once it exceeds this many updates.
# COMPACTION_THRESHOLD=50

# Extra browser origins allowed to call the API (comma-separated). The desktop
# app's origins are always allowed, so you do not need this for normal use.
# CORS_ORIGINS=

# Multi-instance only. LEAVE UNSET for a single server — it uses in-memory
# pub/sub. Set it only when running several instances behind a load balancer, so
# they share the vault replication feed.
# REDIS_URL=redis://redis:6379

# Billing is OFF unless POLAR_ACCESS_TOKEN is set, and OFF means no limits at
# all: unlimited vaults, unlimited members. Self-hosters want it off. Leave this
# block alone.
# POLAR_ACCESS_TOKEN=
