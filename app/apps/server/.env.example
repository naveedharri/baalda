# Deployment policy is independent of optional billing setup.
# Self-hosters keep AI access with or without their own billing provider.
# Cloud deployments use cloud (also the safe default when omitted): AI is Pro-only.
BAALDA_DEPLOYMENT=self-hosted

# --- Baalda · sync + app server ---

# Postgres. docker-compose maps host 5439 -> container 5432.
DATABASE_URL=postgres://context:context@localhost:5439/context

# Max Postgres connections this instance keeps in its pool. Default 30.
# Raise it for a busy instance; keep the total across ALL instances under the
# server's max_connections. A vault reconnect alone spends BACKFILL_CONCURRENCY
# of these, so a pool much smaller than that starves the HTTP routes.
# PG_POOL_MAX=30

# Shared signing secret: Better Auth crypto + HS256 sync/vault JWTs.
# REQUIRED. Generate a real one — do NOT ship this placeholder:
#   openssl rand -base64 32
# In production (NODE_ENV=production) the server REFUSES to start if this is
# unset or left at the placeholder below. Locally it warns and runs.
JWT_SECRET=dev-only-insecure-change-me-please-32bytes

# Public base URL Better Auth uses to build links (email verify / invitations).
BETTER_AUTH_URL=http://localhost:3010

# HTTP API port (Better Auth, sync-token, shares, registry). Hono app.
PORT=3010

# Hocuspocus WebSocket port. Kept separate from the HTTP port for clarity;
# both processes share one Node process. See README "Ports".
# The same Hocuspocus instance is ALSO served on the HTTP PORT at path /sync —
# single-port deployments (Docker/Railway, which expose exactly one port) use
# that instead of this dedicated port.
HOCUSPOCUS_PORT=3011

# Per-doc sync JWT TTL (seconds). Spec: 5-15 min. Default 10 min.
SYNC_TOKEN_TTL_SECONDS=600

# Compaction threshold: merge doc_updates into a snapshot when the log exceeds this.
COMPACTION_THRESHOLD=50

# Days a deleted note stays in the vault's Trash (restorable, still accepting
# offline teammates' edits) before its content is purged. Default 30.
# TRASH_RETENTION_DAYS=30

# Hard ceiling for one note's markdown TEXT, in MB (sync messages + MCP writes).
# A circuit breaker against runaway growth (e.g. a writer looping on one note);
# real notes are far smaller. Images don't count — embedded screenshots live in
# attachments/ and sync through the blob store, not the note body.
MAX_NOTE_MB=10

# Quiet time after a note's last edit before a version is auto-captured (ms).
# Default 600000 (10 minutes). Lower it in local dev to test version history.
# VERSION_IDLE_MS=600000

# --- Attachments storage ---

# Where an attachment's BYTES live: `postgres` (default) or `s3`.
#
# `postgres` keeps them in the database, which is what makes a self-host
# zero-configuration: no bucket, no credentials, one backup. `s3` puts them in
# any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, …) and lets clients
# upload and download STRAIGHT to it, so a 500 MB video never passes through
# this process.
#
# The provider is recorded on every blob row at upload time, so flipping this
# later never orphans what is already stored — a server set back to `postgres`
# keeps serving everything written while it was on `s3`.
#
# An unrecognised value, or `s3` without a complete bucket configuration, is a
# FATAL startup error rather than a silent fallback.
# BLOB_STORAGE=postgres

# Hard ceiling for ONE attachment, in bytes. Default 25 MB.
# Sized against the heap, not against taste: the Postgres provider cannot stream
# a value in or out (node-postgres has no binary parameter protocol), so an
# N-byte attachment costs roughly 3.7N at peak and this process runs with V8
# capped at 512 MB. Raise it only alongside the container's memory.
# MAX_BLOB_BYTES=26214400

# Total upload-body bytes admitted at once. Default: 2x MAX_BLOB_BYTES, and
# never less than MAX_BLOB_BYTES (a single max-size upload must be admissible).
# This is what stops N compliant uploads from summing past the heap; beyond it
# uploads queue, then shed with 503.
# MAX_INFLIGHT_UPLOAD_BYTES=52428800

# What to do with an upload whose Content-Type is not a type Baalda knows:
# `reject` (default) answers 415, `warn` logs it and stores it anyway. Use
# `warn` on an existing server to see what enforcement WOULD refuse before
# turning it on.
# BLOB_MIME_ENFORCE=reject

# How long an abandoned upload may hold its content's dedupe slot before the
# sweep removes it. A blob row is created at `intent`, before any byte moves; a
# client that quits mid-upload leaves it `pending`. Default 60 minutes, which is
# a 500 MB file on a slow line with room to spare. Always on.
# BLOB_PENDING_TTL_MINUTES=60

# Free-tier attachment storage per unsubscribed vault, in MB. Default 1024.
# Only enforced when billing is enabled (POLAR_ACCESS_TOKEN set) and only
# against a vault with no active subscription — a self-hosted server never meets
# it. Gates new uploads with 402 `storage_limit_reached`; lowering it never
# deletes anything.
# FREE_MAX_STORAGE_MB=1024

# --- Attachment garbage collection ---

# Delete stored attachments that no note references any more. OFF by default,
# and the only sweep that removes something a user made.
#
# It decides from `blob_refs`, a table derived from note text, so every way that
# table can be incomplete (a vault not yet re-indexed, a device that has been
# offline, a reference style the extractor does not recognise) points the same
# way: towards calling a live attachment an orphan. Turn it on once you have
# seen a full re-index, and read the `[blob-gc] orphan removed:` log lines.
#
# The deletion QUEUE — removing objects whose row a vault or org delete already
# took away — is always on and is not affected by this switch.
# BLOB_GC_ENABLED=false

# How long an unreferenced attachment must have existed before it is
# collectable. Default 30 days. Not a tidiness knob: an attachment is uploaded
# before the note that embeds it is written, and that note may arrive days later
# from a device that was offline.
# BLOB_GC_ORPHAN_DAYS=30

# Minimum gap between orphan sweeps, in ms. Default 6 hours. (The GC ticks every
# 15 minutes for the always-on sweeps; this rate-limits the orphan pass on top.)
# BLOB_GC_INTERVAL_MS=21600000

# Hard ceiling on deletions in ONE orphan sweep. Default 200. The blast radius
# if the reference table is somehow wrong — and a log line per deletion saying
# exactly which files went.
# BLOB_GC_MAX_DELETES_PER_RUN=200

# --- Attachments on S3 / R2 / MinIO (only read when BLOB_STORAGE=s3) ---

# The bucket and its credentials. All three are REQUIRED for BLOB_STORAGE=s3;
# the server refuses to start without them rather than quietly using Postgres.
# Create the bucket first — the server never creates one.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Region, and the endpoint for anything that is not AWS S3.
#   AWS S3          leave S3_ENDPOINT unset; set the real region.
#   Cloudflare R2   S3_REGION=auto
#                   S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
#   MinIO           S3_ENDPOINT=http://minio:9000 (or your host)
#                   S3_FORCE_PATH_STYLE=true  — MinIO has no bucket-per-subdomain DNS
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Optional path prefix for NEW object keys: <prefix>/vaults/<vaultId>/<sha256>.
# `staging/` lets staging and production share one bucket; production leaves it
# empty. Every row stores the FULL key, so changing this never strands what is
# already uploaded — reads, deletes and GC keep using the stored key.
# S3_KEY_PREFIX=

# How long the URLs handed to a client live, in seconds.
# Uploads get 900 (a big file on a slow line); downloads 300 (fetched at once).
# NOTE: a presigned URL is signed against the SERVER's clock. If this machine
# drifts more than ~15 minutes from the bucket's, every signature is rejected —
# run NTP.
# S3_PRESIGN_UPLOAD_TTL_SECONDS=900
# S3_PRESIGN_DOWNLOAD_TTL_SECONDS=300

# Stream downloads THROUGH this server instead of redirecting to the bucket.
# Off by default (a redirect costs us no egress and no socket). Turn it on when
# clients cannot reach the bucket directly — e.g. a MinIO on a private subnet.
# S3_PROXY_DOWNLOADS=false

# What a direct upload is asked to prove: auto (default) | sha256 | md5 | none.
# `auto` = sha256 on real AWS, md5 against any custom endpoint — Cloudflare R2
# implements only Content-MD5, so a signed x-amz-checksum-sha256 would fail
# every single upload there. Size is verified server-side either way.
# S3_CHECKSUM_MODE=auto

# Where a single PUT becomes a presigned multipart upload, and how big each part
# is. AWS's own threshold is 100 MB; below it a single PUT is simpler, above it
# a failure with no resume and no parallelism is a bad deal. 16 MB parts x the
# 10 000-part protocol limit is 160 GB of headroom.
# S3_MULTIPART_THRESHOLD_BYTES=104857600
# S3_MULTIPART_PART_BYTES=16777216

# Ceiling for ONE attachment on S3, in bytes. Default 500 MB. Unlike
# MAX_BLOB_BYTES this is a product decision, not a heap bound: with a direct
# upload the bytes never enter this process. Per-category caps still apply
# (video 500 MB, audio 200, pdf 100, document 50, image 25, text 10).
# MAX_BLOB_BYTES_DIRECT=524288000

# --- Vault sync engine (spec 05) ---

# Cross-instance fanout for the vault replication channel. LEAVE UNSET for
# single-instance dev/self-host — the server uses in-memory pub/sub. Set it only
# to run multiple server instances behind a load balancer (HA / rolling deploys);
# then all instances share the vault feed via Redis.
# Local HA testing: `docker compose --profile ha up` then REDIS_URL=redis://localhost:6389
# REDIS_URL=redis://localhost:6389

# Max docs streamed concurrently to a freshly-connected vault subscriber (backfill).
BACKFILL_CONCURRENCY=6

# WebSocket path for the vault replication channel (served on the HTTP PORT).
VAULT_SYNC_PATH=/vault-sync

# --- Bulk sync engine (bootstrap + batch) ---
# Per-request item ceilings for the /batch registration + content-push routes.
# The desktop mirrors these in lib/sync/pool.ts and chunks to them, so raising
# one here without raising it there simply leaves headroom unused.
# BATCH_MAX_NOTES=200
# BATCH_MAX_FOLDERS=500
# BATCH_MAX_FILES=200
# BATCH_MAX_DOCS=100
# Total DECODED update bytes one docs/batch may carry (4 MiB). The route also
# takes a 16 MB body limit; this is the heap bound behind it.
# BATCH_MAX_DECODED_BYTES=4194304
# Whole-vault bootstrap download. A page is merged and gzipped in heap before a
# byte is sent, so CONCURRENCY x PAGE_BYTES is the floor of the peak — raise
# either only alongside the container's memory. Past CONCURRENCY a page request
# answers 503 + Retry-After; past TTL_HOURS it answers 410 and the client
# re-POSTs with a fresh `have`.
# BOOTSTRAP_MAX_PAGE_BYTES=4194304
# BOOTSTRAP_MAX_PAGE_DOCS=256
# BOOTSTRAP_CONCURRENCY=4
# BOOTSTRAP_TTL_HOURS=24

# --- Google OAuth (social sign-in) ---

# Google OAuth "Web application" client. LEAVE UNSET to disable Google sign-in
# (the desktop hides the button; email+password still works). Create the client
# at console.cloud.google.com → APIs & Services → Credentials, with authorized
# redirect URIs:
#   http://localhost:3010/api/auth/callback/google   (dev)
#   https://<your-server>/api/auth/callback/google    (prod)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# URL scheme of the desktop app that this server's pages (/open/*, /invite/:id,
# /email-verified, /reset-password) hand off to. Leave unset for `baalda` (the
# released app). A server behind the "Baalda Staging" app must say
# `baalda-staging`, or its links open whichever app registered baalda:// last.
# DEEP_LINK_SCHEME=baalda

# --- Outbound email (password reset, sign-up verification, invitations) ---

# Email is OFF unless configured, and every feature that needs it is then simply
# not offered: no "Forgot password?" in the app, invitations are shared as a
# link (Members → Copy link) instead of emailed. To turn it on, set the sender
# address AND ONE transport. Links in the emails are built from BETTER_AUTH_URL,
# so that must be the address people can actually reach.
# EMAIL_FROM=Baalda <no-reply@example.com>
#
# Either any SMTP server (smtp:// = STARTTLS on 587, smtps:// = TLS on 465)…
# SMTP_URL=smtp://user:password@smtp.example.com:587
# …or Resend (https://resend.com) over HTTPS:
# RESEND_API_KEY=re_...
#
# EMAIL_TRANSPORT forces a transport instead of inferring it from the credential
# above: smtp | resend | log | memory. `log` prints emails to stdout (handy for
# local dev), `memory` is for the test suite; both are refused in production.
# EMAIL_TRANSPORT=log
#
# No email and someone is locked out? `pnpm run set-password -- their@email`
# writes a fresh password from the server's shell (see docs/DEPLOY.md).

# --- Subscription billing (Polar) ---

# Billing is OFF unless POLAR_ACCESS_TOKEN is set. Self-hosters should leave this
# ENTIRE block unset: with billing off there are NO free-tier limits — unlimited
# vaults and unlimited members — and GET /api/billing/config reports
# { enabled: false } while every other /api/billing/* route returns 404.
#
# To turn billing on (the managed baalda.com option does this), create a Polar
# organization + two products (monthly $10, yearly $97), then set:
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=          # from the Polar webhook endpoint you register
# POLAR_SERVER=sandbox           # 'sandbox' (default) or 'production'
# POLAR_PRODUCT_MONTHLY_ID=      # Polar product id for the $10/mo Pro plan
# POLAR_PRODUCT_YEARLY_ID=       # Polar product id for the $97/yr Pro plan
#
# Free-tier caps (only enforced when billing is ON). Defaults: 2 and 3.
# Accounts present when migration 031 runs retain their recorded 3-vault limit.
# They also retain attachment sync in free vaults; new accounts need an active
# Pro subscription on the vault to transfer attachments. Existing bytes stay.
# FREE_MAX_VAULTS=2              # unsubscribed vaults a new user may own
# FREE_MAX_MEMBERS=3             # members + pending invites per unsubscribed vault

# Baalda Assistant is included for self-hosters. On Baalda Cloud it requires Pro; users supply their own model keys.
# HOUSEKEEPER_MODULE=/absolute/path/to/housekeeper/index.mjs
# Development-only, loopback database required. Never enabled by default.
# HOUSEKEEPER_LOCAL_PREVIEW=false
