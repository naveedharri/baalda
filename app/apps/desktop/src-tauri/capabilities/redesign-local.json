{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "redesign-local-windows-mode",
  "description": "LOCAL ONLY: lets the Windows-mode preview on a Mac use the custom window buttons",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
