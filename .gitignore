# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
target/
.turbo/
app/apps/desktop/gen/schemas/

# Environment & secrets — never commit real keys
.env
.env.*
!.env.example
*.key
*.key.pub
*.local

# Logs
*.log
logs/

# OS / editor cruft
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local app data (derived index + CRDT store)
.context/

# Per-run staging config overlay, generated by .github/workflows/staging-release.yml
# (the committed half of the overlay is src-tauri/tauri.staging.conf.json)
app/apps/desktop/src-tauri/tauri.staging.build.conf.json

# Claude session runtime lock
.claude/scheduled_tasks.lock
